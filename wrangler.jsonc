{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thework",
  "main": "worker.js",
  "compatibility_date": "2026-09-26",
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/stories/*", "/sitemap.xml"],
    "not_found_handling": "single-page-application"
  }
}
